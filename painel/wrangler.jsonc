{
  // Painel da Casa: Worker + D1. Segredo obrigatório: CODIGO_INICIAL (Settings → Variables and Secrets),
  // usado só para cadastrar a PRIMEIRA passkey. O banco D1 "painel" é criado sozinho no primeiro deploy.
  "name": "painel-casa",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // o Worker vê tudo primeiro: OAuth (/authorize, /oauth/*, /.well-known/*), /mcp e /api; o resto vai para public/
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "painel" }],
  // tokens do OAuth (o Claude entrando pelo painel); criado sozinho no deploy
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "observability": { "enabled": true }
}
