{
  "name": "painel-casa",
  "private": true,
  "type": "module",
  "description": "Painel externo de administração do controle-ir: passkeys, armação assinada, cadastro de aparelhos e auditoria",
  "scripts": {
    "build": "node -e \"require('fs').copyFileSync('node_modules/@simplewebauthn/browser/dist/bundle/index.umd.min.js','public/webauthn.js')\"",
    "dev": "npm run build && wrangler dev --local --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.1.0"
  },
  "devDependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "wrangler": "4.165.0"
  }
}
