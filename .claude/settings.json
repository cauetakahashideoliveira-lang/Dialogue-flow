{
  "permissions": {
    "allow": [
      "mcp__Controle_Geral",
      "mcp__Controle_Geral__*",
      "mcp__Controle_master",
      "mcp__Controle_master__*",
      "mcp__96238baf-d75f-494e-8948-efdbfa7d7344",
      "mcp__96238baf-d75f-494e-8948-efdbfa7d7344__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/godmode-tracker.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
